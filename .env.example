# Teacher LLM provider: openai | anthropic | auto
# auto = prefer OpenAI if OPENAI_API_KEY is set, else Anthropic.
TEACHER_PROVIDER=openai

# Any model your provider/key can access, for example:
#   OpenAI: gpt-4o-mini, gpt-4o, gpt-4.1-mini, o4-mini
#   Anthropic: claude-3-5-sonnet-latest, claude-sonnet-4-0
#   OpenAI-compatible gateways: whatever that gateway exposes
TEACHER_MODEL_ID=gpt-4o-mini

# Student / fine-tune base model (Unsloth QLoRA)
BASE_MODEL_ID=unsloth/Meta-Llama-3.1-8B-Instruct-bnb-4bit

# --- OpenAI (teacher / dataset bootstrap only) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Local ATS serving (native Windows Ollama, OpenAI-compatible) ---
# Model name MUST match `ollama list` / `ollama run <name>`.
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_ID=resume-screener
LLM_API_KEY=ollama
FRONTEND_ORIGIN=http://localhost:3000

# --- Anthropic (optional alternate teacher) ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Official cloud API. Avoid dead local proxies (e.g. 127.0.0.1:1337) unless intentional.
ANTHROPIC_BASE_URL=https://api.anthropic.com
